#!/bin/sh

# Husky invoque toujours ce script via `sh` (.husky/_/h fait `sh -e "$script"`), qui
# ignore le shebang ci-dessus. Sur les systèmes où /bin/sh n'est pas bash (ex: dash),
# la syntaxe tableau plus bas casse — on se relance donc explicitement sous bash.
if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

# Variables d'environnement pour personnaliser
TALISMAN_HOME=${TALISMAN_HOME:-"$HOME/.talisman"}
SKIP_TALISMAN=${SKIP_TALISMAN:-false}

# Si skip est activé
if [ "$SKIP_TALISMAN" = "true" ]; then
    echo "⚠️  Skipping secret detection (SKIP_TALISMAN=true)"
    exit 0
fi

# Fonction pour trouver Talisman (POSIX sh : pas de tableaux bash, husky exécute
# toujours les hooks via `sh`, pas via le shebang du script)
find_talisman() {
    for path in \
        "/c/Users/$USER/.talisman/talisman.exe" \
        "/mnt/c/Users/$USER/.talisman/talisman.exe" \
        "$USERPROFILE/.talisman/talisman.exe" \
        "$HOME/.talisman/talisman" \
        "$TALISMAN_HOME/talisman" \
        "/usr/local/bin/talisman" \
        "/usr/bin/talisman"
    do
        if [ -f "$path" ] && [ -x "$path" ]; then
            echo "$path"
            return 0
        fi
    done

    # Chercher dans le PATH
    if command -v talisman >/dev/null 2>&1; then
        echo "talisman"
        return 0
    fi

    return 1
}

TALISMAN=$(find_talisman) || true

if [ -n "$TALISMAN" ]; then
    echo "🔍 Running Talisman security scan..."
    "$TALISMAN" --githook pre-commit
    exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo ""
        echo "❌ Commit blocked: secrets detected!"
        echo "   Review the files above or use SKIP_TALISMAN=true git commit to bypass"
    fi
    exit $exit_code
else
    echo "⚠️  WARNING: Talisman not found!"
    echo "    Secret detection is DISABLED"
    echo "    Install from: https://github.com/thoughtworks/talisman"
    echo ""

    # En mode interactif uniquement. On tente de lire depuis /dev/tty (le vrai terminal)
    # plutôt que de se fier à `-t 0` : certains clients git (GitKraken, VS Code, IDE...)
    # présentent un stdin qui ressemble à un TTY sans transmettre de vraie frappe — `read`
    # reçoit alors une réponse vide, interprétée comme "non", et bloque le commit à tort.
    # `-r /dev/tty` ne suffit pas non plus : le fichier peut être "lisible" (permissions) sans
    # qu'aucun terminal contrôlant ne soit réellement attaché (process détaché, CI...), auquel
    # cas l'ouverture échoue au runtime ("No such device or address"). On tente donc directement
    # la lecture et on se rabat sur "continuer" si la redirection échoue.
    if read -p "Continue without secret detection? (y/N) " -n 1 -r 2>/dev/null < /dev/tty; then
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    else
        # Pas de terminal accessible (CI, hook lancé sans TTY) - avertir mais continuer
        echo "    ⚠️  Continuing without secret detection (no interactive terminal available)"
        exit 0
    fi
fi
